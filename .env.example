# Open Protocol CRUD dashboard — environment overrides.
# Copy this file to `.env` (gitignored) and edit as needed.
#
# The launcher (run.py) and the Streamlit app read these variables.
# They can also be passed on the command line, e.g. `python run.py --db ...`.


# --- Database --------------------------------------------------------------
# Default: a local SQLite file in the project folder.
# DATABASE_URL=sqlite:///database.sqlite

# PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# MySQL / MariaDB:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# Microsoft SQL Server:
# DATABASE_URL=mssql+pyodbc://user:password@host/dbname?driver=ODBC+Driver+17+for+SQL+Server


# --- Controller defaults (used as placeholders in the UI) -----------------
# OPEN_PROTOCOL_DEFAULT_HOST=192.168.188.120
# OPEN_PROTOCOL_DEFAULT_PORT=4545


# --- Misc ------------------------------------------------------------------
# OPEN_PROTOCOL_PLATFORM is set automatically by run.py; do not override.
# PYTHONUNBUFFERED=1
