# Open Protocol CRUD dashboard - environment overrides.
# Copy this file to `.env` (gitignored) and edit as needed.
#
# The launcher (run.py) and the Streamlit app read these variables.
# They can also be passed on the command line, e.g. `python run.py --db ...`.


# --- GitHub push workflow --------------------------------------------------
# Used by `scripts/push_with_pat.sh` to push local commits and tags when
# SSH git ops are blocked at the ACL layer. The script reads this var,
# pushes in env-var-only mode, and wipes the token + bash history.
#
# Generate a token at https://github.com/settings/tokens:
#   - Note:       one-shot push for <whatever>
#   - Expiration: 7 days (shortest)
#   - Scopes:     repo only
#
# IMPORTANT:
#   - .env is in .gitignore; do not commit it.
#   - Revoke the token immediately after use.
#   - The previous "paste the token in chat" workflow is retired as of v1.2.10.
# GITHUB_TOKEN=<your_pat>


# --- Database --------------------------------------------------------------
# Resolution order (see `app/paths.py:get_database_url()`):
#   1. DATABASE_URL env var (highest priority)
#   2. db_config.json in the project folder, as edited by the Setup tab
#   3. Built-in default: a local SQLite file in the project folder
#
# Setting DATABASE_URL here overrides whatever is in db_config.json.
# Leave it commented out to let the Setup tab drive the configuration.
# DATABASE_URL=sqlite:///database.sqlite

# PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# MySQL / MariaDB:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# Microsoft SQL Server:
# DATABASE_URL=mssql+pyodbc://user:password@host/dbname?driver=ODBC+Driver+17+for+SQL+Server


# --- Controller defaults (used as placeholders in the UI) -----------------
# OPEN_PROTOCOL_DEFAULT_HOST=192.168.188.120
# OPEN_PROTOCOL_DEFAULT_PORT=4545


# --- Misc ------------------------------------------------------------------
# OPEN_PROTOCOL_PLATFORM is set automatically by run.py; do not override.
# PYTHONUNBUFFERED=1
